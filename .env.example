# Copy to .env and fill in real values before deploying. Never commit a real .env.

# --- Database ---
POSTGRES_USER=focussentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=focussentinel
DATABASE_URL=postgresql+psycopg://focussentinel:change-me@postgres:5432/focussentinel

# --- Redis (used by future Celery/rate-limiting features) ---
REDIS_URL=redis://redis:6379/0

# --- API ---
JWT_SECRET=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=development

# This service's own public URL -- used to build the Approve/Deny links in
# a parent's extension-request email. Set to the API's real deployed domain
# in production; localhost is fine for local dev.
PUBLIC_API_BASE_URL=http://localhost:8000

# --- Web dashboard ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Notification providers (server-side only; never exposed to clients) ---
EMAIL_PROVIDER=console        # console | smtp | sendgrid
SMS_PROVIDER=console          # console | twilio

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@focussentinel.example

SENDGRID_API_KEY=
